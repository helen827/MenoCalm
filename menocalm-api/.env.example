# Copy to .env and load before run (do not commit .env)
SPRING_PROFILES_ACTIVE=dev
MYSQL_URL="jdbc:mysql://127.0.0.1:3306/live_more?useSSL=false&characterEncoding=utf8"
MYSQL_USER=root
MYSQL_PASSWORD=replace-mysql-password
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-at-least-32-random-chars-in-real-env
# JWT_ACCESS_SECONDS=1800
# REFRESH_TOKEN_TTL_SECONDS=2592000
# LEGACY_PHONE_LOGIN_ENABLED=false
# TEST_ACCOUNT_LOGIN_ENABLED=false
# TEST_ACCOUNT_SECRET=replace-test-account-secret
# COMMUNITY_SEED_ON_EMPTY=false
# CORS_ALLOWED_ORIGINS=https://your-admin.example,https://chaoan-community-admin.onrender.com
# Comma-separated JWT user ids allowed for GET/DELETE /api/v1/admin/community/**
# COMMUNITY_ADMIN_USER_IDS=phone_13800138000
# When hosting menocalm-admin-web on another origin, add it to CORS_ALLOWED_ORIGINS
# e.g. CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,https://admin.example.com,https://chaoan-community-admin.onrender.com
# LOGIN_RATE_LIMIT_PER_PHONE_MAX=8
# LOGIN_RATE_LIMIT_PER_IP_MAX=20
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=replace-sms-sign-name
SMS_TEMPLATE_CODE=replace-sms-template-code
SMS_ACCESS_KEY_ID=replace-sms-access-key-id
SMS_ACCESS_KEY_SECRET=replace-sms-access-key-secret
# SMS_REGION_ID=cn-hangzhou
# SMS_CODE_TTL_SECONDS=300
# SMS_RESEND_COOLDOWN_SECONDS=60
# SMS_PER_PHONE_PER_HOUR_MAX=6
# SMS_PER_IP_PER_HOUR_MAX=20
# SMS_MAX_VERIFY_ATTEMPTS=8
WECHAT_APP_ID=replace-wechat-app-id
WECHAT_APP_SECRET=replace-wechat-app-secret
# WECHAT_UNIVERSAL_LINK=https://proudmenopause.com/
# WECHAT_REDIRECT_URI=chaoan://wechat/callback
# Calendar day for same-day chat context (Java ZoneId, e.g. Asia/Shanghai, UTC)
# CONVERSATIONS_DAILY_CONTEXT_ZONE_ID=Asia/Shanghai
# AI temperatures (Component A/B/C)
# AI_CHAT_TEMPERATURE=0.55
# AI_EXTRACTION_TEMPERATURE=0.3
# AI_REPORT_TEMPERATURE=0.7
# AI provider (Qiniu LLM, OpenAI-compatible endpoint)
# AI_PROVIDER=qiniu
# AI_ENDPOINT=https://your-qiniu-llm-endpoint/v1/chat/completions
# AI_API_KEY=replace-ai-api-key
# AI_MODEL=replace-ai-model-name
# AI_CONNECT_TIMEOUT_MS=5000
# AI_READ_TIMEOUT_MS=15000

# Object storage (S3 compatible: AWS S3 / MinIO / OSS / COS)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=live-more-assets
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-secret-key
S3_REGION=us-east-1
# S3_PRESIGN_TTL_SECONDS=600
# S3_PUBLIC_BASE_URL=
